# ==============================================================================
# Dovecot PostgreSQL User & Password Query Mapping
# ==============================================================================

driver = pgsql
connect = host=postgres dbname=mailserver user=mailuser password=StrongSecureDBPassword_123
default_pass_scheme = ARGON2ID

password_query = SELECT email AS user, password_hash AS password \
  FROM users WHERE email = '%u' AND is_active = TRUE;

user_query = SELECT '/var/mail/vhosts/' || '%d/' || '%n' AS home, \
  5000 AS uid, 5000 AS gid, quota_bytes AS quota_rule \
  FROM users WHERE email = '%u' AND is_active = TRUE;

iterate_query = SELECT email AS user FROM users WHERE is_active = TRUE;
